# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# Node (plugin packages under plugins/)
node_modules/
dist/
lib/
*.tsbuildinfo

# Python / uv (backend and data pipelines)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local harness state — never commit
.env
.env.*
!.env.example
.dsh-home/

# Customer source drops — local only
client-data/**
!client-data/README.md

# Reference clones — local only, except the frozen xiaoliang snapshot
other-projects/*
!other-projects/README.md
!other-projects/xiaoliang/
!other-projects/xiaoliang/**
other-projects/xiaoliang/.git/
other-projects/xiaoliang/.git.dsh-hidden/

# Data Layer products — regenerate from pipelines
data/datasets/

# Local CAD extractor build/output
dev-test/**/bin/
dev-test/**/obj/
dev-test/**/.vs/
dev-test/**/out/
dev-test/**/out-thcad/
dev-test/**/compare/
dev-test/**/*.user
dev-test/**/*.suo
dev-test/**/scripts/*.scr

# Cloud-dev scratch — keep source, drop runtime leftovers
cloud-dev/**/out/
cloud-dev/**/tmp/

# 复制本文件为 .env 后修改（.env 已加入 .gitignore，勿提交密钥）

# 运行环境
APP_NAME=晓量后端服务
APP_VERSION=0.7.4
APP_ENV=development
# 生产务必 false；true 只放大自家业务 DEBUG，不会再刷 httpx/httpcore 连接日志
DEBUG=true

# CORS，逗号分隔；生产环境必须填写明确来源，不能使用 *
CORS_ORIGINS=*

# 同步接口跑在 AnyIO 线程池里，云文档解析会长时间占用线程，默认 40 会饿死登录/计费接口。
# 必须至少容纳文档并发、文档排队上限，并额外为登录/计费等接口保留 40 个 worker。
SERVER_THREAD_POOL_SIZE=160

# 数据库
# 应用实际使用 DATABASE_URL；下方 DB_* 主要给 scripts/init_postgres.py 复用。
# 本地 sqlite 示例：
# DATABASE_URL=sqlite:///./xiaoliang_backend.db
# 如果远端 PostgreSQL 未开启 SSL，可在 URL 后追加 ?sslmode=disable
DATABASE_URL=postgresql+psycopg://your_user:your_password@127.0.0.1:5432/xiaoliang
# SQLAlchemy QueuePool；SQLite 会忽略以下参数。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
AUTO_CREATE_TABLES=true

# 本地文件存储根目录（后续 evidence / algorithm artifacts 可复用）
STORAGE_ROOT=./storage
# 以下两项仅作历史兼容；桌面安装包已改为 DB + OSS，不再依赖本机目录直出。
CLIENT_RELEASE_MANIFEST_PATH=./release-manifests/latest.json
CLIENT_RELEASE_ASSETS_DIR=./storage/client-releases

# 桌面客户端发布 / 自动更新
RELEASE_ADMIN_TOKEN=change-me-release-admin-token
DESKTOP_UPDATE_BASE_URL=https://xl.x3yun.com/api/desktop-updates
OSS_RELEASE_SIGNED_URL_EXPIRES_SECONDS=21600

# 市场 skill 包 Ed25519 签名；私钥只放发布机/密钥服务，不进入仓库或 OSS
SKILL_PACK_SIGNING_PRIVATE_KEY_PATH=
SKILL_PACK_SIGNING_KEY_ID=primary-v1

# JWT
JWT_SECRET_KEY=change-me-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
# Desktop agent turns use access token as model Bearer; keep long enough for CAD workflows.
ACCESS_TOKEN_EXPIRES_MINUTES=1440
REFRESH_TOKEN_EXPIRES_DAYS=7

# 腾讯云邮件服务配置
TENCENT_SECRET_ID=replace-me
TENCENT_SECRET_KEY=replace-me
TENCENT_REGION=ap-hongkong
TENCENT_FROM_EMAIL=noreply@example.com
TENCENT_TEMPLATE_ID=0
# 若模板里还有其它占位符名（如 {{otp}}），在此填写键名；留空则只使用下方默认注入的 code/content
TENCENT_TEMPLATE_CODE_KEY=
TENCENT_TEMPLATE_EXPIRE_KEY=
TENCENT_TEMPLATE_EXTRA_VARS={"action_id":"#","unsubscribe_token":"none"}

# 邮箱验证码登录（与上方腾讯云模板配合；未配置密钥或 TENCENT_TEMPLATE_ID=0 时仅在后端日志打印验证码）
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAIL_SUBJECT=晓量登录验证码

# ===== 托管对话网关（桌面 Agent 只认 xiaoliang-agent-* 别名）=====
# 对话主模型 / 图纸文字问答 → AGENT_DEFAULT_MODEL（别名 xiaoliang-agent-default）
AGENT_DEFAULT_MODEL=qwen3.8-max
# 视觉识图索引 / 视觉探查 / 识图融合 → AGENT_VISION_MODEL（别名 xiaoliang-agent-vision）
AGENT_VISION_MODEL=qwen3.8-max
# 预留 expert 别名（当前桌面未接；深度思考仍走 default + enable_thinking）
AGENT_EXPERT_MODEL=qwen3.8-max
# 上下文压缩摘要 → AGENT_COMPACTION_MODEL（桌面端 Pi 压缩走 /chat/completions 打 compaction 标）
AGENT_COMPACTION_MODEL=qwen3.8-max
# GET /agent/v1/models 是桌面端模型能力唯一事实源；以下值由该目录下发。
AGENT_DEFAULT_CONTEXT_WINDOW=1000000
AGENT_MAX_OUTPUT_TOKENS=65536
AGENT_CAD_QUERY_MAX_OUTPUT_TOKENS=16384
AGENT_VISUAL_INDEX_MAX_OUTPUT_TOKENS=4096
# schema_repair 为预留档位，当前无调用方
AGENT_SCHEMA_REPAIR_MAX_OUTPUT_TOKENS=8192
AGENT_COMPACTION_MAX_OUTPUT_TOKENS=4096
AGENT_GATEWAY_TIMEOUT_SECONDS=120
# 流式上游连续无数据的读取超时，防止死连接永久占用工作线程。
AGENT_GATEWAY_STREAM_READ_TIMEOUT_SECONDS=300
# 非流式 cad_query / visual_index / schema_repair；需高于桌面端最长 30 分 30 秒预算。
AGENT_GATEWAY_CAD_TIMEOUT_SECONDS=2100
AGENT_GATEWAY_REQUIRE_RUN_ID=true

# Credits 计费：credits = ceil(百炼真实成本 × 倍率 / 0.008)
# 倍率 10/9 ≈ 1.111 → 入门约 10% 模型毛利；标准 / 专业靠更低单价再薄一些
BILLING_CREDIT_MARKUP=1.111111
# 影子模式：设为 false 时按真实 token 定价并落 status='shadow' 账目，
# 但不扣余额、不拦截调用。上线流程见 docs/credits-billing.md：
# 先跑一周影子 → scripts/reconcile_shadow_credits.py 对账 → 发放存量 grant → 改回 true
BILLING_CREDITS_ENFORCE=true
# 注册一次性赠送额度（用完即止，不再每日重置）
BILLING_SIGNUP_GRANT_CREDITS=2000
# 算力包有效期（天）
BILLING_GRANT_DURATION_DAYS=365

# 微信 Native 支付（计费）
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_CERT_SERIAL_NO=
WECHATPAY_APIV3_KEY=
WECHATPAY_PRIVATE_KEY_PATH=wechatpay_key/apiclient_key.pem
WECHATPAY_CERT_DIR=wechatpay_key
WECHATPAY_NOTIFY_URL=https://xl.x3yun.com/api/billing/wechat/native/notify

# Alibaba Cloud OSS
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-me
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-me
OSS_BUCKET=replace-me
OSS_REGION=cn-beijing
# 生产建议留空，使下载走私有 OSS 短期签名 URL；仅调试时可填 CDN/公网基址。
OSS_PUBLIC_BASE_URL=

# 桌面端运行时资产分发（/runtime-assets/git-bash，供 AI bash 工具一键准备）。
# 运维步骤：从 git-for-windows 官方 release 下载 MinGit-<ver>-64-bit.zip 上传到
# OSS 的下述 key，并按官方 release 页填写 SHA-256。未配置时接口返回 404，
# 桌面端自动回退 npmmirror / 华为云镜像。
RUNTIME_ASSET_GIT_BASH_OBJECT_KEY=
RUNTIME_ASSET_GIT_BASH_SHA256=
RUNTIME_ASSET_GIT_BASH_VERSION=
RUNTIME_ASSET_GIT_BASH_SIZE_BYTES=0

# 项目包后台归档（客户端使用后端签发的 PUT URL 直传私有 OSS）
# 同一开关也控制自制 skill 账号级归档（/user-skills/archive/*）。
PROJECT_ARCHIVE_ENABLED=true
PROJECT_ARCHIVE_UPLOAD_URL_TTL_SECONDS=3600
# 仅限制单个项目归档文件；传输不经过 FastAPI 进程。
PROJECT_ARCHIVE_MAX_FILE_MB=2048
SUBAGENT_TRACE_ARCHIVE_ENABLED=true
SUBAGENT_TRACE_UPLOAD_URL_TTL_SECONDS=3600
SUBAGENT_TRACE_MAX_FILE_MB=128
PROJECT_MESSAGE_ATTACHMENT_MAX_MB=20

# 项目复杂文档云解析：qwen-doc 读取 OSS 短期签名 URL；PDF 再兜底 qwen3.8-max PDF 理解，
# 最后兜底 qwen-long Files API。
PROJECT_DOCUMENT_CLOUD_ENABLED=true
PROJECT_DOCUMENT_MODEL=qwen-doc-turbo
PROJECT_DOCUMENT_FALLBACK_MODEL=qwen-long
# PDF 专用第二条兜底，直接吃签名 URL，不需要上传整个文件。
PROJECT_DOCUMENT_PDF_VISION_ENABLED=true
PROJECT_DOCUMENT_PDF_VISION_MODEL=qwen3.8-max
PROJECT_DOCUMENT_SIGNED_URL_TTL_SECONDS=900
PROJECT_DOCUMENT_TIMEOUT_SECONDS=600
# 并发上限只是保护后端的安全阀：满了会排队，不会因此报「云端繁忙」。
PROJECT_DOCUMENT_MAX_CONCURRENCY=32
# 最多允许这些请求占用同步 worker 排队；再多会立即返回本地队列已满。
PROJECT_DOCUMENT_MAX_QUEUE_DEPTH=64
PROJECT_DOCUMENT_QUEUE_WAIT_SECONDS=300
# 仅对限流和瞬时错误退避重试；参数错误、格式不支持等直接进下一条兜底。
PROJECT_DOCUMENT_PROVIDER_MAX_ATTEMPTS=3
PROJECT_DOCUMENT_PROVIDER_RETRY_BASE_SECONDS=2
PROJECT_DOCUMENT_MAX_OUTPUT_TOKENS=32768
PROJECT_DOCUMENT_FALLBACK_PARSE_TIMEOUT_SECONDS=900
PROJECT_DOCUMENT_FALLBACK_POLL_INTERVAL_SECONDS=2
PROJECT_DOCUMENT_MAX_FILE_MB=150

# Aliyun DashScope
DASHSCOPE_REGION=cn
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=replace-me
AGENT_CONVERSATION_TITLE_MODEL=qwen3.7-max
AGENT_CONVERSATION_TITLE_TIMEOUT_SECONDS=15
QWEN_WEB_SEARCH_MODEL=qwen3.8-max
QWEN_WEB_FETCH_MODEL=qwen3.8-max
QWEN_WEB_SOURCE_LIMIT=8
QWEN_WEB_SEARCH_TIMEOUT_SECONDS=90
QWEN_WEB_FETCH_TIMEOUT_SECONDS=180
# 博查 SERP：/web/search 的首选通道，返回结构化命中而非模型综述；未配置、失败或空命中时自动降级 Qwen。
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_SEARCH_COUNT=10
BOCHA_TIMEOUT_SECONDS=30
QWEN_PATIENT_ASR_MODEL=qwen3-asr-flash
QWEN_PATIENT_ASR_ENABLE_ITN=false
QWEN_PATIENT_ASR_LANGUAGE=
PATIENT_ASR_MAX_FILE_SIZE_MB=10
PATIENT_ASR_ALLOWED_EXTENSIONS=.webm,.wav,.mp3,.m4a,.ogg,.opus,.aac,.flac,.amr
PATIENT_ASR_ALLOWED_MIME_TYPES=audio/webm,audio/wav,audio/mpeg,audio/mp4,audio/ogg,audio/opus,audio/aac,audio/flac,audio/amr,video/webm,application/octet-stream
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INDEX=0

# PostgreSQL 拆分配置（给初始化脚本复用）
DB_NAME=xiaoliang
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-engineer.local/schemas/cad-capabilities/inventory-manifest.schema.json",
  "title": "CAD capability inventory manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "surface",
    "observed_host_id",
    "captured_at",
    "extractor",
    "source_artifacts",
    "atoms_file",
    "atoms_sha256",
    "counts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "inventory_id": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": ["com", "dotnet", "lisp", "command", "native"]
    },
    "observed_host_id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "name", "version", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "atoms_file": { "const": "capability-atoms.jsonl" },
    "atoms_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atoms", "by_kind", "source"],
      "properties": {
        "atoms": { "type": "integer", "minimum": 0 },
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "source": {
          "type": "object",
          "description": "Surface-specific source counts such as interfaces, methods, properties or symbols.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

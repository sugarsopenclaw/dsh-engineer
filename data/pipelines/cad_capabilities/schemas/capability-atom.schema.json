{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-engineer.local/schemas/cad-capabilities/capability-atom.schema.json",
  "title": "CAD capability atom",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "atom_id",
    "canonical_key",
    "surface",
    "atom_kind",
    "observed_host_ids",
    "source_artifact",
    "declaring_symbol",
    "member",
    "provenance",
    "surface_metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "inventory_id": { "type": "string", "minLength": 1 },
    "atom_id": {
      "type": "string",
      "pattern": "^cap:(com|dotnet|lisp|command|native):[a-f0-9]{24}$"
    },
    "canonical_key": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": ["com", "dotnet", "lisp", "command", "native"]
    },
    "atom_kind": {
      "enum": [
        "method",
        "property_get",
        "property_set",
        "constructor",
        "event_subscribe",
        "event_unsubscribe",
        "field_read",
        "field_write",
        "lisp_function",
        "command",
        "macro",
        "progid_activation",
        "native_export"
      ]
    },
    "observed_host_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "name", "version", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "declaring_symbol": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol_id", "full_name", "kind"],
          "properties": {
            "symbol_id": { "type": "string", "minLength": 1 },
            "full_name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "signature",
        "return_type",
        "parameters",
        "is_static"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "return_type": { "type": ["string", "null"] },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "name", "type", "direction", "optional"],
            "properties": {
              "position": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" },
              "type": { "type": "string", "minLength": 1 },
              "direction": { "enum": ["in", "out", "ref", "return"] },
              "optional": { "type": "boolean" },
              "default_value": {}
            }
          }
        },
        "is_static": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "extractor_version", "source_locator"],
      "properties": {
        "extractor": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 },
        "source_locator": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      }
    },
    "surface_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

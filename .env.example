# 复制为仓库根目录 .env 后填写。只认这一份；子目录不要再放 .env。
# .env 不进 git。增删或改键名时必须与 .env 同时改，键集合保持一致。
#
# 前端只暴露 VITE_*（或 bundler 约定前缀）。密钥不要加这个前缀。
# Vite / Python / Node / Compose 都显式读仓库根，不要复制文件。
# Pi 启动脚本会把本文件注入子进程，不打印值。

# --- LLM ---
# Pi 主模型与 THCAD 视觉子代理使用。
DEEPSEEK_API_KEY=

# --- Data Layer ---
# 管线用到的键写在这里。

# --- Backend ---
# 服务端密钥、数据库等写在这里。
# ── 数据库 ──
# PostgreSQL 已退出 FastAPI 运行链路；以下旧键只为退役脚本兼容，不再探测或连接。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://app:password@127.0.0.1:5432/appdb
# FastAPI 只使用这一份本机 SQLite；旧业务需求 / CAD 查询库已清理。
BUSINESS_REQUIREMENTS_SQLITE=data/datasets/local/topology-semantics.sqlite
CAD_CAPABILITIES_SQLITE=data/datasets/local/topology-semantics.sqlite
TOPOLOGY_SEMANTICS_SQLITE=data/datasets/local/topology-semantics.sqlite
# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0
# ── 阿里云 OSS ──
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_BUCKET=transformer-shenbian
OSS_REGION=cn-beijing
OSS_PUBLIC_BASE_URL=
# ── 阿里云 DashScope（通义千问）──
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DOC_MODEL=qwen-doc-turbo
QWEN_REHEARSAL_LONG_MODEL=qwen-long

# ── THCAD 视觉子代理 ──
SHENBIAN_THCAD_DEEPSEEK_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
SHENBIAN_THCAD_XAI_VISION_MODEL=xai/grok-4.6
SHENBIAN_THCAD_VISION_THINKING=high
SHENBIAN_UV_EXECUTABLE=uv
SHENBIAN_BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Frontend（会进浏览器，只放 VITE_*）---
# VITE_API_BASE_URL=

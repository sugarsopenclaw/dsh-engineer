# 复制为仓库根目录 .env 后填写。只认这一份；子目录不要再放 .env。
# .env 不进 git。增删或改键名时必须与 .env 同时改，键集合保持一致。
#
# 前端只暴露 VITE_*（或 bundler 约定前缀）。密钥不要加这个前缀。
# Vite / Python / Node / Compose 都显式读仓库根，不要复制文件。
#
# DSH 只读「调用目录/.env」和 $DSH_HOME/.env，不往上找。
# 当前日常是 cd harness 再跑 dsh，因此不会自动读本文件。
# 若改成从仓库根启动 dsh，本文件里不要写下列键，否则拒启：
# DSH_*、DEEPSEEK_BASE_URL、DEEPSEEK_SEARCH_BASE_URL、BROWSER、HTTP(S)_PROXY 等。
# 这些走 shell / CI / 容器注入。DEEPSEEK_API_KEY 可以写在这里。

# --- DSH / LLM ---
DEEPSEEK_API_KEY=

# --- Data Layer ---
# 管线用到的键写在这里。

# --- Backend ---
# 服务端密钥、数据库等写在这里。
# ── 数据库 ──
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://app:password@127.0.0.1:5432/appdb
# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0
# ── 阿里云 OSS ──
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_BUCKET=transformer-shenbian
OSS_REGION=cn-beijing
OSS_PUBLIC_BASE_URL=
# ── 阿里云 DashScope（通义千问）──
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DOC_MODEL=qwen-doc-turbo
QWEN_REHEARSAL_LONG_MODEL=qwen-long

# --- Frontend（会进浏览器，只放 VITE_*）---
# VITE_API_BASE_URL=
